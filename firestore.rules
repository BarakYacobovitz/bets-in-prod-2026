rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 👑 בודק האם המשתמש הוא האדמין הראשי לפי האימייל שלך
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'bawak.y10@gmail.com';
    }
    
    // 👤 בודק האם המשתמש מנסה לערוך את המסמך השייך לו
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // חוק-על: לאדמין (באימייל המורשה) יש גישה מלאה לקריאה וכתיבה של כל המידע
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- חוקים למשתמשים רגילים ---

    // ⚽ משחקים, הגדרות ותוצאות אמת: קריאה בלבד לכל משתמש מחובר
    match /matches/{docId} { 
      allow read: if request.auth != null; 
    }
    match /settings/{docId} { 
      allow read: if request.auth != null; 
    }
    match /admin_results/{docId} { 
      allow read: if request.auth != null; 
    }
    
    // 👥 פרופיל משתמש
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // מאפשר יצירת פרופיל לשחקן חדש רק עם ערכי ברירת מחדל בטוחים (0 נקודות, ללא תשלום)
      allow create: if request.auth != null && isOwner(userId)
        && request.resource.data.totalPoints == 0
        && request.resource.data.knockoutPoints == 0
        && request.resource.data.hasPaid == false;
      
      // מאפשר למשתמש לעדכן את הפרופיל של עצמו (כמו שם, טוקן התראות וכו') 
      // אך מונע ממנו לעדכן נקודות, תשלום, או סטטיסטיקות משחק
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny([
             'totalPoints', 'knockoutPoints', 'hasPaid', 'breakdown', 
             'previousTotalPoints', 'previousKnockoutPoints', 
             'previousRankGeneral', 'previousRankKnockout'
           ]);
    }
    
    // 🥇 ניחושי עולות מהבתים
    match /predictions_qualifiers/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isOwner(userId);
    }
    
    // 🥉 ניחושי עולות מקום שלישי
    match /predictions_third_place/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isOwner(userId);
    }
    
    // 🎁 ניחושי שאלות בונוס
    match /predictions_bonus/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isOwner(userId);
    }
    
    // 🏟️ ניחושי משחקים בודדים (שלב הבתים)
    match /predictions_matches/{predId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // 🏆 ניחושי משחקים בודדים (שלב הנוקאאוט)
    match /predictions_knockout/{predId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // 👥 ליגות פרטיות
    match /mini_leagues/{leagueId} {
      allow read: if request.auth != null;
      
      // יצירת ליגה מותרת לכל משתמש מחובר שמגדיר את עצמו כמנהל הליגה (adminId)
      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid;
      
      // עדכון ליגה:
      allow update: if request.auth != null && (
        // א. מנהל הליגה יכול לשנות הכל (שם ליגה, PIN וכו')
        resource.data.adminId == request.auth.uid ||
        // ב. משתמש אחר יכול רק להצטרף/לעזוב (משנה רק את מערך ה-members ע"י הוספה/הסרה של ה-UID שלו בלבד)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
         (request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid]) ||
          resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])))
      );
      
      // מחיקה מותרת רק למנהל הליגה שיצר אותה
      allow delete: if request.auth != null && resource.data.adminId == request.auth.uid;
    }

    // 💬 סקר שביעות רצון (משובים)
    match /feedbacks/{userId} {
      allow read, write: if request.auth != null && isOwner(userId);
    }
  }
}
